# Copy to .env and edit as needed:  cp .env.example .env
# All values below are the defaults.

# Any sentence-transformers model. CLIP models support both text and images.
EMBED_MODEL_NAME=clip-ViT-B-32

# cpu or cuda. Leave commented out to auto-detect.
# EMBED_DEVICE=cpu

# Maximum number of texts accepted in one /embed/text request.
EMBED_MAX_BATCH_SIZE=64

# debug, info, warning, error. Use debug to see per-request timings.
EMBED_LOG_LEVEL=info
